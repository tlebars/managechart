# Compose variables. Copy to docker/.env and fill in:  cp docker/.env.example docker/.env

# Symfony environment: prod (default) or dev
APP_ENV=
# 0 or 1
APP_DEBUG=
# Required: long random string, e.g. `openssl rand -hex 32`
APP_SECRET=

# PostgreSQL (service "db")
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Mailer DSN, e.g. smtp://user:pass@smtp.example.org:587 (null://null disables mails)
MAILER_DSN=
# Sender address of reset-password mails
MAILER_FROM=

# Comma-separated IPs/CIDRs of the reverse proxy (e.g. 172.18.0.0/16). Empty = no trusted proxy.
TRUSTED_PROXIES=
